generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model candidatos {
  id                  Int     @id @default(autoincrement())
  nome_partido        String  @db.VarChar(255)
  numero_candidato    String  @db.VarChar(50)
  nome_candidato      String  @db.VarChar(50)
  nome_urna_candidato String  @db.VarChar(255)
  fk_idcargo          Int?
  cargos              cargos? @relation(fields: [fk_idcargo], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model cargos {
  id           Int          @id @default(autoincrement())
  codigo_cargo String       @db.VarChar(50)
  nome_cargo   String       @db.VarChar(255)
  candidatos   candidatos[]
}

model local_votacao {
  id              Int        @id @default(autoincrement())
  zona            Int
  fk_id_municipio Int
  codigo_local    String     @db.VarChar(50)
  local_votacao   String     @db.VarChar(255)
  municipios      municipios @relation(fields: [fk_id_municipio], references: [id], onDelete: Cascade, onUpdate: NoAction)
  votos           votos[]
}

model municipios {
  id               Int             @id @default(autoincrement())
  codigo_municipio String          @db.VarChar(50)
  nome_municipio   String          @db.VarChar(255)
  local_votacao    local_votacao[]
}

model votos {
  id                 Int           @id @default(autoincrement())
  numero_partido     String        @db.VarChar(50)
  fk_idcandidato     Int
  qtd_votos          Int
  fk_idlocal_votacao Int
  secao              String?       @db.VarChar(50)
  local_votacao      local_votacao @relation(fields: [fk_idlocal_votacao], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
